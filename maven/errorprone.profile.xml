        <!-- Error Prone: Error Prone's own bug checks and NullAway, at ERROR, on main sources.
             Error Prone 2.50 runs only on JDK 21+, while the SDK targets Java 17 and its
             release build runs on JDK 17, so the profile activates by JDK: every build on
             JDK 21+ (including the CI job that exists for it) is checked, and a JDK 17
             build compiles exactly as before. The javac internals Error Prone needs are
             opened in .mvn/jvm.config. Scope:
             - Error Prone's default-enabled checks, and failOnWarning (javac -Werror), so a
               check whose default severity is WARNING fails the build like an ERROR one.
               -Werror also fails on javac's own default warnings (removal, for one), which
               are worth failing on too; suggestions stay notes. A new Error Prone version
               brings its new checks in at ERROR: triage them on upgrade.
             - Checks that are pure style for this code base are disabled by name below,
               each with its reason. A real exception is a @SuppressWarnings with a reason.
             - Beyond the defaults, two bug finders that fit this code base:
               CheckReturnValue over reactor.core.publisher: a Mono or Flux operator whose
               result is dropped never runs. Results that are fine to drop (subscribe's
               Disposable, a terminal tryEmit*, fluent sink callbacks) are listed with
               reasons in config/errorprone/reactor-ignorable-results.txt.
               SystemOut: the stdio transport owns System.out, and anything else printed
               there corrupts the JSON-RPC stream.
             - NullAway: only @NullMarked packages (OnlyNullMarked), in JSpecify mode.
             - only the main compile execution (default-compile; a target that replaces it, as the
               MCP Java SDK does with java-compile, names its own id here): test sources are
               deliberately unchecked;
             - never fork the compiler (compiler-plugin then hides every diagnostic). -->
        <profile>
            <id>errorprone</id>
            <activation>
                <jdk>[21,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default-compile</id>
                                <configuration>
                                    <!-- errorprone.failOnWarning and errorprone.extraArgs are properties so that
                                         `measure` can run the same profile in report mode:
                                         -Derrorprone.failOnWarning=false -Derrorprone.extraArgs=-XepAllErrorsAsWarnings -->
                                    <failOnWarning>${errorprone.failOnWarning}</failOnWarning>
                                    <compilerArgs>
                                        <arg>-XDcompilePolicy=simple</arg>
                                        <arg>-Xmaxerrs</arg>
                                        <arg>10000</arg>
                                        <arg>-Xmaxwarns</arg>
                                        <arg>10000</arg>
                                        <arg>--should-stop=ifError=FLOW</arg>
                                        <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                                        <!-- Disabled, as style, each with its reason in configs/errorprone/disabled-checks.txt:
                                             StatementSwitchToExpressionSwitch, InlineMeSuggester, MissingSummary. -->
                                        <arg>-Xplugin:ErrorProne -Xep:StatementSwitchToExpressionSwitch:OFF -Xep:InlineMeSuggester:OFF -Xep:MissingSummary:OFF -Xep:SystemOut:ERROR -XepOpt:CheckReturnValue:Packages=reactor.core.publisher -XepOpt:CheckReturnValue:ApiExclusionList=${maven.multiModuleProjectDirectory}/config/errorprone/reactor-ignorable-results.txt -Xep:NullAway:ERROR -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:OnlyNullMarked=true ${errorprone.extraArgs}</arg>
                                    </compilerArgs>
                                    <annotationProcessorPaths>
                                        <path>
                                            <groupId>com.google.errorprone</groupId>
                                            <artifactId>error_prone_core</artifactId>
                                            <version>${errorprone.version}</version>
                                        </path>
                                        <path>
                                            <groupId>com.uber.nullaway</groupId>
                                            <artifactId>nullaway</artifactId>
                                            <version>${nullaway.version}</version>
                                        </path>
                                    </annotationProcessorPaths>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
