// Template: replace {{ROOT_PACKAGE}} with the module's root package (the common prefix of its
// packages, which `measure-archunit` prints), or any valid test package when no common named
// package exists. This names the test's package, not an import filter. Drop into test sources.
// Uses ArchUnit as a plain library (`com.tngtech.archunit:archunit`, test scope) from an ordinary
// JUnit test, not ArchUnit's JUnit engine: the engine pins a JUnit Platform version, which
// collided with JUnit 6 on the MCP SDK. Imports the module's own compiled main classes, not a
// package from the classpath: a package can span modules, and an anchor class's package tree
// misses sibling packages (both found on the MCP SDK).
package {{ROOT_PACKAGE}};

import com.tngtech.archunit.core.domain.JavaClass;
import com.tngtech.archunit.core.domain.JavaClasses;
import com.tngtech.archunit.core.importer.ClassFileImporter;
import com.tngtech.archunit.library.dependencies.SliceAssignment;
import com.tngtech.archunit.library.dependencies.SliceIdentifier;
import org.junit.jupiter.api.Test;

import static com.tngtech.archunit.library.dependencies.SlicesRuleDefinition.slices;
import static org.junit.jupiter.api.Assertions.assertFalse;

/**
 * No dependency cycles between the packages of this module, at any depth, and none between
 * top-level classes inside a package. Main sources only.
 */
class NoCyclesTest {

	/** This module's compiled main classes: Maven's target/classes, or Gradle's build/classes/java/main. */
	private static final JavaClasses CLASSES = new ClassFileImporter()
		.importPath(java.nio.file.Files.isDirectory(java.nio.file.Path.of("target", "classes")) ? java.nio.file.Path.of("target", "classes")
				: java.nio.file.Path.of("build", "classes", "java", "main"));

	/** All imported packages participate, including the root itself and the default package. */
	private static final SliceAssignment PACKAGE = new SliceAssignment() {
		@Override
		public SliceIdentifier getIdentifierOf(JavaClass javaClass) {
			String name = javaClass.getPackageName();
			return SliceIdentifier.of(name.isEmpty() ? "<default package>" : name);
		}

		@Override
		public String getDescription() {
			return "packages";
		}
	};

	/** Every top-level class is a slice; its nested classes belong to it. */
	private static final SliceAssignment TOP_LEVEL_CLASS = new SliceAssignment() {
		@Override
		public SliceIdentifier getIdentifierOf(JavaClass javaClass) {
			return SliceIdentifier.of(javaClass.getName().split("\\$")[0]);
		}

		@Override
		public String getDescription() {
			return "top-level classes";
		}
	};

	@Test
	void importsSomething() {
		// an empty import would let both rules pass vacuously
		assertFalse(CLASSES.isEmpty(), "no classes imported for {{ROOT_PACKAGE}}: is the test running from the module directory with main classes compiled?");
	}

	/** Every imported package is a slice; a cycle between any two fails. */
	@Test
	void noPackageCycles() {
		slices().assignedFrom(PACKAGE).should().beFreeOfCycles().check(CLASSES);
	}

	/** A cycle between classes of one package fails. */
	@Test
	void noClassCycles() {
		slices().assignedFrom(TOP_LEVEL_CLASS).should().beFreeOfCycles().check(CLASSES);
	}

}
