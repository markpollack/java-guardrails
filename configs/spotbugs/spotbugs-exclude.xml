<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions (spotbugs-maven-plugin, `verify`, main sources), applied to the findings
  spotbugs-include.xml selects: rank 9 or less, and the listed concurrency patterns. This file
  starts empty in a new target; each entry is added by the owner's decision.

  Each entry is one false positive, named by class, method and bug pattern, with the reason it is
  false. Never exclude a whole pattern or package: a real instance of the same pattern elsewhere
  must still fail the build. A finding that is a real bug or a risky pattern is fixed in the code.

  Exposure patterns (EI_EXPOSE_REP, EI_EXPOSE_REP2: records and value objects handing out the
  components they hold) are rank 18 and not selected by the include filter, so they need no entry
  here.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!--
      Example of the only acceptable shape, from acp-java (UR_UNINIT_READ, rank 3): a constructor
      read a field that a method-reference callback assigns synchronously when the transport
      refuses to start; SpotBugs does not follow the assignment. Class, method, field and pattern,
      with the reason:

    <Match>
        <Class name="com.example.Session"/>
        <Method name="&lt;init&gt;"/>
        <Field name="startFailure"/>
        <Bug pattern="UR_UNINIT_READ"/>
    </Match>
    -->

</FindBugsFilter>
